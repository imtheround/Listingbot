{
  "apps": [
    {
      "name": "autosecure-api",
      "script": ".venv/bin/python",
      "args": "-m uvicorn autosecure.core.app:app --host 0.0.0.0 --port 8000",
      "cwd": "/opt/autosec",
      "autorestart": true,
      "watch": false,
      "max_restarts": 5,
      "restart_delay": 3000
    },
    {
      "name": "autosecure-admin",
      "script": "npx",
      "args": "next start -p 3001",
      "cwd": "/opt/autosec/admin-dashboard",
      "autorestart": true,
      "watch": false,
      "max_restarts": 5,
      "restart_delay": 3000
    },
    {
      "name": "autosecure-user",
      "script": "npx",
      "args": "next start -p 3000",
      "cwd": "/opt/autosec/dashboard",
      "autorestart": true,
      "watch": false,
      "max_restarts": 5,
      "restart_delay": 3000
    }
  ]
}
